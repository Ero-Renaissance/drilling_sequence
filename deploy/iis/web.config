<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for Drilling Sequence — Windows Integrated Auth.
  RULE-ONLY version: the auth switches and the server-variable allowlist are
  deliberately NOT in this file. IIS locks those sections at the server level,
  and declaring them here throws 500.19 (0x80070021) before any request reaches
  the app. Configure them once at the server level instead (below).

  What this file does: reverse-proxies every request to uvicorn on
  127.0.0.1:8000 (which serves both the API and the built SPA via STATIC_DIR),
  stamping the Windows-authenticated account onto the X-Remote-User header the
  backend reads (PROXY_USER_HEADER). Setting it from {LOGON_USER} OVERWRITES
  anything the client sent, so the identity can't be forged.

  ONE-TIME SERVER-LEVEL SETUP (IIS Manager, or the appcmd equivalents):
  1. Install the "Windows Authentication" role service
     (Server Manager -> Web Server (IIS) -> Web Server -> Security).
  2. Install URL Rewrite + ARR, then enable the ARR proxy:
     IIS Manager -> server node -> Application Request Routing Cache ->
     Server Proxy Settings -> tick "Enable proxy".
  3. Auth switches — set on the SITE via IIS Manager (writes to
     applicationHost.config, so no unlock needed):
     site -> Authentication -> Anonymous Authentication = Disabled,
     Windows Authentication = Enabled.
       appcmd set config "SITE-NAME" -section:system.webServer/security/authentication/windowsAuthentication /enabled:true /commit:apphost
       appcmd set config "SITE-NAME" -section:system.webServer/security/authentication/anonymousAuthentication /enabled:false /commit:apphost
  4. Server variables — allow them at the SERVER node (they cannot live in a
     site web.config): server node -> URL Rewrite -> View Server Variables… ->
     add HTTP_X_REMOTE_USER and HTTP_X_PROXY_AUTH.
       appcmd set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_REMOTE_USER']" /commit:apphost
       appcmd set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_PROXY_AUTH']" /commit:apphost

  Also required (see docs/deployment-guide.md section 2 + Appendix B):
    - uvicorn bound to 127.0.0.1:8000 ONLY (never 0.0.0.0) — and ideally a
      firewall rule blocking :8000 inbound — so nothing can bypass IIS and
      present a forged header.
    - backend\.env: DEV_MODE=false, PROXY_USER_HEADER=X-Remote-User
      (+ optional PROXY_SHARED_SECRET, matched by the X-Proxy-Auth line below).
    - The app URL in each browser's Local Intranet zone (usually via GPO) for
      silent sign-on.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Proxy everything to FastAPI (it serves the API + the built SPA),
             stamping the Windows-authenticated user onto each request. -->
        <rule name="ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
          <serverVariables>
            <!-- From IIS's authenticated LOGON_USER (DOMAIN\user). Setting it here
                 OVERWRITES any X-Remote-User the client sent, so it can't be forged. -->
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
            <!-- Optional hardening: uncomment AND set PROXY_SHARED_SECRET to the
                 same value in backend\.env — but only after silent sign-in works.
            <set name="HTTP_X_PROXY_AUTH" value="SAME-SECRET-AS-IN-ENV" />
            -->
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
