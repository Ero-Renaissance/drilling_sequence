<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse proxy for Drilling Sequence — Windows Integrated Auth.

  IIS authenticates the browser (Negotiate/Kerberos, NTLM fallback), REFUSES
  anonymous, and reverse-proxies every request to uvicorn on 127.0.0.1:8000
  (which serves both the API and the built SPA via STATIC_DIR). It stamps the
  authenticated Windows account onto the X-Remote-User header the backend reads
  (PROXY_USER_HEADER), OVERWRITING anything the client sent so the identity can't
  be forged.

  Prerequisites (see docs/deployment-guide.md section 2 + Appendix B):
    - IIS role service "Windows Authentication" installed.
    - URL Rewrite + ARR installed, and the ARR proxy ENABLED:
      IIS Manager -> server node -> Application Request Routing Cache ->
      Server Proxy Settings -> tick "Enable proxy".
    - uvicorn bound to 127.0.0.1:8000 ONLY (never 0.0.0.0) — and ideally a
      firewall rule blocking :8000 inbound — so nothing can bypass IIS and
      present a forged header.
    - backend\.env: DEV_MODE=false, PROXY_USER_HEADER=X-Remote-User
      (+ optional PROXY_SHARED_SECRET, matched by the X-Proxy-Auth line below).
    - The app URL in each browser's Local Intranet zone (usually via GPO) for
      silent sign-on.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <!-- URL Rewrite may only set the request headers listed here; without this
           the <set> below fails with a 500. -->
      <allowedServerVariables>
        <add name="HTTP_X_REMOTE_USER" />
        <add name="HTTP_X_PROXY_AUTH" />
      </allowedServerVariables>
      <rules>
        <!-- Proxy everything to FastAPI (it serves the API + the built SPA),
             stamping the Windows-authenticated user onto each request. -->
        <rule name="ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:1}" />
          <serverVariables>
            <!-- From IIS's authenticated LOGON_USER (DOMAIN\user). Setting it here
                 OVERWRITES any X-Remote-User the client sent, so it can't be forged. -->
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
            <!-- Optional hardening: uncomment AND set PROXY_SHARED_SECRET to the
                 same value in backend\.env — but only after silent sign-in works.
            <set name="HTTP_X_PROXY_AUTH" value="SAME-SECRET-AS-IN-ENV" />
            -->
          </serverVariables>
        </rule>
      </rules>
    </rewrite>
    <security>
      <authentication>
        <!-- The crux: IIS does the Kerberos/NTLM handshake and refuses anonymous,
             so LOGON_USER is always populated before the rewrite runs. -->
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>
  </system.webServer>
</configuration>
